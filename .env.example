# Default target: OpenAI. For Ollama, use http://127.0.0.1:11434/v1 and
# explicitly set UPSTREAM_ALLOWED_HOSTS=127.0.0.1.
UPSTREAM_BASE_URL=https://api.openai.com/v1
UPSTREAM_ALLOWED_HOSTS=api.openai.com
VEIL_HOST=127.0.0.1
VEIL_PORT=8080
MAX_REQUEST_BYTES=1048576
UPSTREAM_TIMEOUT_SECONDS=30
VAULT_TTL_SECONDS=300
CONVERSATION_SCOPE=false
# Optional: JSONL audit file; contains types/counts only.
# AUDIT_LOG_PATH=./var/audit.jsonl
# Optional YAML policy.
# VEIL_POLICY_FILE=./policy.yaml
